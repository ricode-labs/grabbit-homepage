			},
			{
				title: "高速ダウンロード",
				body: "マルチスレッド加速と賢いリソース配分で、回線をしっかり使い切れます。",
			},
			{
				title: "再開対応",
				body: "中断しても大丈夫。途中から再開でき、進捗を無駄にしません。",
			},
			{
				title: "タスク管理",
				body: "見やすい一覧、分類、並び替え、一括操作で、作業を整理しやすくします。",
			},
			{
				title: "クリーンで安全",
				body: "広告なし、同梱なし。オープンで透明性があり、プライバシーとデータを守ります。",
			},
		],
		closing: {
			title: "すべてのダウンロードを、<br />もっと気持ちよく。",
			body: 'grabbit はいつもそばにいて、<br />欲しいものを気軽に <span>grab</span> できるようにします。',
		},
		changelog: "更新履歴",
	},
};

const defaultMessages = messages.en;
const localeNames = {
	en: "English",
	zh: "中文",
	ja: "日本語",
};

const downloads = [
	{
		key: "windows",
		icon: "windows",
		primary: true,
	},
	{
		key: "linux",
		icon: "linux",
		primary: false,
	},
	{
		key: "macos",
		icon: "apple",
		primary: false,
	},
];

const base = import.meta.env.BASE_URL;
const asset = (path = "") => `${base}${path.replace(/^\/+/, "")}`;
const iconStyles = `--icon-windows: url("${asset("windows.svg")}"); --icon-linux: url("${asset("linux.svg")}"); --icon-apple: url("${asset("apple.svg")}"); --icon-github: url("${asset("github.svg")}"); --icon-protocol: url("${asset("protocol.svg")}"); --icon-cloud-download: url("${asset("cloud-download.svg")}");`;

const features = [
	{
		titleKey: "features.0.title",
		bodyKey: "features.0.body",
		image: "/pending.webp",
		icon: "cloud",
		iconAsset: "protocol",
		tone: "pink",
	},
	{
		titleKey: "features.1.title",
		bodyKey: "features.1.body",
		image: "/downloading.webp",
		icon: "bolt",
		tone: "stone",
	},
	{
		titleKey: "features.2.title",
		bodyKey: "features.2.body",
		image: "/paused.webp",
		icon: "upload",
		iconAsset: "cloud-download",
		tone: "orange",
	},
	{
		titleKey: "features.3.title",
		bodyKey: "features.3.body",
		image: "/pending.webp",
		icon: "list",
		tone: "green",
	},
	{
		titleKey: "features.4.title",
		bodyKey: "features.4.body",
		image: "/downloaded.webp",
		icon: "shield",
		tone: "brown",
		wide: true,
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/webp" href={asset("favicon.webp?v=2")} />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={defaultMessages.description} />
		<meta name="generator" content={Astro.generator} />
		<title>{defaultMessages.title}</title>
	</head>
	<body style={iconStyles}>
		<main class="page-shell">
			<nav
				class="topbar"
				aria-label={defaultMessages.nav.primary}
				data-i18n="nav.primary"
				data-i18n-mode="attr"
				data-i18n-attr="aria-label"
			>
				<a
					class="brand"
					href={asset("")}
					aria-label={defaultMessages.nav.home}
					data-i18n="nav.home"
					data-i18n-mode="attr"
					data-i18n-attr="aria-label"
				>
					<img src={asset("logo.svg")} alt="" width="36" height="36" />
					<span>grabbit</span>
				</a>

				<div class="nav-links">
					<details class="lang-switcher" data-language-switcher>
						<summary
							class="lang-switcher-button"
							aria-label={defaultMessages.nav.language}
							data-i18n="nav.language"
							data-i18n-mode="attr"
							data-i18n-attr="aria-label"
						>
							<span class="lang-switcher-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24">
									<circle cx="12" cy="12" r="9"></circle>
									<path d="M3 12h18M12 3c3.2 3.5 3.2 14.5 0 18M12 3c-3.2 3.5-3.2 14.5 0 18"></path>
								</svg>
							</span>
						</summary>
						<div class="lang-switcher-menu" aria-label={defaultMessages.nav.language}>
							{Object.entries(localeNames).map(([locale, label]) => (
								<button
									class="lang-switcher-option"
									type="button"
									data-locale-option
									data-locale={locale}
									aria-pressed={locale === "en" ? "true" : "false"}
								>
									<span>{label}</span>
								</button>
							))}
						</div>
					</details>
					<a class="github-link" href="https://github.com/ricode-labs/grabbit" target="_blank" rel="noreferrer">
						<span class="github-icon" aria-hidden="true"></span>
						<span data-i18n="nav.github">{defaultMessages.nav.github}</span>
					</a>
				</div>
			</nav>

			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-copy">
					<h1 id="hero-title" data-i18n="hero.title" data-i18n-mode="html" set:html={defaultMessages.hero.title}></h1>
					<p class="hero-lede" data-i18n="hero.lede">{defaultMessages.hero.lede}</p>

					<div
						class="download-actions"
						id="downloads"
						aria-label={defaultMessages.hero.downloadsLabel}
						data-i18n="hero.downloadsLabel"
						data-i18n-mode="attr"
						data-i18n-attr="aria-label"
					>
						{downloads.map((download) => (
							<button
								class:list={["download-button", download.primary && "download-button-primary"]}
								type="button"
								disabled
							>
								<span class={`platform-icon platform-icon-${download.icon}`} aria-hidden="true"></span>
								<strong data-i18n={`downloadLabels.${download.key}`}>
									{defaultMessages.downloadLabels[download.key]}
								</strong>
							</button>
						))}
					</div>

					<p class="support-note" data-i18n="hero.support">
						{defaultMessages.hero.support}
					</p>
				</div>

				<div
					class="app-preview"
					aria-label={defaultMessages.hero.previewLabel}
					data-i18n="hero.previewLabel"
					data-i18n-mode="attr"
					data-i18n-attr="aria-label"
				>
					<div class="screenshot-shell">
						<div class="screenshot-titlebar">
							<img src={asset("logo.svg")} alt="" width="30" height="30" />
							<strong>{defaultMessages.screenshot.title}</strong>
							<div class="screenshot-controls" aria-hidden="true">
								<span></span><span></span><span></span>
							</div>
						</div>
						<div class="screenshot-placeholder">
							<img src={asset("sidebar-bg.webp")} alt="" width="230" height="180" />
							<div>
								<strong data-i18n="screenshot.placeholderTitle">{defaultMessages.screenshot.placeholderTitle}</strong>
								<span data-i18n="screenshot.placeholderText">{defaultMessages.screenshot.placeholderText}</span>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section class="features" id="features" aria-labelledby="features-title">
				<h2 id="features-title">
					<span>✿</span>
					<span data-i18n="featuresTitle" data-i18n-mode="html" set:html={defaultMessages.featuresTitle}></span>
					<span>✿</span>
				</h2>

				<div class="feature-grid">
					{features.map((feature, index) => (
						<article class:list={["feature-card", feature.wide && "feature-card-wide"]}>
							<div class={`feature-icon feature-icon-${feature.tone}`} aria-hidden="true">
								{feature.iconAsset && <span class={`asset-icon asset-icon-${feature.iconAsset}`}></span>}
								{!feature.iconAsset && feature.icon === "cloud" && (
									<svg viewBox="0 0 24 24"><path d="M12 5v10m0 0-4-4m4 4 4-4" /><path d="M6 18h11a4 4 0 0 0 .8-7.92A6 6 0 0 0 6.2 8.7 4.7 4.7 0 0 0 6 18Z" /></svg>
								)}
								{!feature.iconAsset && feature.icon === "bolt" && (
									<svg viewBox="0 0 24 24"><path d="M13 2 4 14h7l-1 8 10-13h-7l0-7Z" /></svg>
								)}
								{!feature.iconAsset && feature.icon === "upload" && (
									<svg viewBox="0 0 24 24"><path d="M12 19V9m0 0-4 4m4-4 4 4" /><path d="M6 18H5a4 4 0 0 1 0-8 7 7 0 0 1 13.5-2A5 5 0 0 1 18 18h-1" /></svg>
								)}
								{!feature.iconAsset && feature.icon === "list" && (
									<svg viewBox="0 0 24 24"><path d="M8 6h11M8 12h11M8 18h11" /><path d="M4 6h.01M4 12h.01M4 18h.01" /></svg>
								)}
								{!feature.iconAsset && feature.icon === "shield" && (
									<svg viewBox="0 0 24 24"><path d="M12 3 5 6v6c0 4.5 2.8 7.6 7 9 4.2-1.4 7-4.5 7-9V6l-7-3Z" /><path d="m9 12 2 2 4-5" /></svg>
								)}
							</div>
							<div class="feature-copy">
								<h3 data-i18n={feature.titleKey}>{defaultMessages.features[index].title}</h3>
								<p data-i18n={feature.bodyKey}>{defaultMessages.features[index].body}</p>
							</div>
							<img src={asset(feature.image)} alt="" width="170" height="170" />
							<span class="flower flower-left" aria-hidden="true"></span>
							<span class="flower flower-right" aria-hidden="true"></span>
						</article>
					))}
				</div>
			</section>

			<section class="closing" id="help" aria-labelledby="closing-title">
				<img src={asset("paused.webp")} alt="" width="210" height="210" />
				<div>
					<h2 id="closing-title" data-i18n="closing.title" data-i18n-mode="html" set:html={defaultMessages.closing.title}></h2>
					<p data-i18n="closing.body" data-i18n-mode="html" set:html={defaultMessages.closing.body}></p>
				</div>
				<img src={asset("downloaded.webp")} alt="" width="210" height="210" />
			</section>

			<div id="changelog" class="sr-only" data-i18n="changelog">{defaultMessages.changelog}</div>
		</main>

		<script is:inline define:vars={{ messages, localeNames }}>
			const storageKey = "grabbit-locale";
			const validLocales = new Set(Object.keys(messages));
			const localeSwitcher = document.querySelector("[data-language-switcher]");
			const localeButtons = document.querySelectorAll("[data-locale-option]");

			const normalizeLocale = (value) => {
				if (!value) {
					return undefined;
				}

				const normalized = String(value).toLowerCase();
				if (normalized.startsWith("zh")) {
					return "zh";
				}

				if (normalized.startsWith("ja")) {
					return "ja";
				}

				if (normalized.startsWith("en")) {
					return "en";
				}

				return undefined;
			};

			const getStoredLocale = () => {
				try {
					return normalizeLocale(localStorage.getItem(storageKey));
				} catch {
					return undefined;
				}
			};

			const setStoredLocale = (locale) => {
				try {
					localStorage.setItem(storageKey, locale);
				} catch {
					// Ignore storage failures.
				}
			};

			const pickLocale = () => {
				const storedLocale = getStoredLocale();
				if (storedLocale) {
					return storedLocale;
				}

				const candidates = navigator.languages?.length ? navigator.languages : [navigator.language];
				for (const candidate of candidates) {
					const locale = normalizeLocale(candidate);
					if (locale) {
						return locale;
					}
				}

				return "en";
			};

			const getPath = (source, path) =>
				path.split(".").reduce((value, key) => {
					if (!value || typeof value !== "object") {
						return undefined;
					}

					return key in value ? value[key] : undefined;
				}, source);

			const applyLocale = (locale, { persist = false } = {}) => {
				const nextLocale = validLocales.has(locale) ? locale : "en";
				const strings = messages[nextLocale] ?? messages.en;

				document.documentElement.lang = strings.htmlLang;
				document.documentElement.dataset.locale = nextLocale;
				document.title = strings.title;

				const description = document.querySelector('meta[name="description"]');
				if (description) {
					description.setAttribute("content", strings.description);
				}

				document.querySelectorAll("[data-i18n]").forEach((node) => {
					const key = node.dataset.i18n;
					if (!key) {
						return;
					}

					const value = getPath(strings, key) ?? getPath(messages.en, key);
					if (typeof value !== "string") {
						return;
					}

					const mode = node.dataset.i18nMode ?? "text";
					if (mode === "html") {
						node.innerHTML = value;
					} else if (mode !== "attr") {
						node.textContent = value;
					}

					const attr = node.dataset.i18nAttr;
					if (attr) {
						node.setAttribute(attr, value);
					}
				});

				localeButtons.forEach((button) => {
					const isActive = button.dataset.locale === nextLocale;
					button.setAttribute("aria-pressed", String(isActive));
				});

				if (persist) {
					setStoredLocale(nextLocale);
				}

				if (localeSwitcher) {
					localeSwitcher.removeAttribute("open");
				}
			};

			applyLocale(pickLocale());

			localeButtons.forEach((button) => {
				button.addEventListener("click", () => {
					const nextLocale = normalizeLocale(button.dataset.locale);
					if (!nextLocale) {
						return;
					}

					applyLocale(nextLocale, { persist: true });
				});
			});
		</script>
	</body>
</html>

<style>
	:root {
		color-scheme: light;
		--brand-cream: #fffbf7;
		--brand-pink-soft: #ffe6ec;
		--brand-pink: #ffc7d4;
		--brand-orange: #f7a94a;
		--brand-green: #79c96b;
		--brand-stone: #bdb0a6;
		--brand-brown: #6b5448;
		--ink: var(--brand-brown);
		--ink-strong: color-mix(in srgb, var(--brand-brown) 86%, black);
		--muted: var(--brand-stone);
		--line: var(--brand-pink-soft);
		--surface: rgba(255, 251, 247, 0.78);
		--surface-solid: var(--brand-cream);
		--cream: var(--brand-cream);
		--pink: var(--brand-pink);
		--pink-deep: color-mix(in srgb, var(--brand-pink) 76%, var(--brand-brown));
		--pink-soft: var(--brand-pink-soft);
		--green: var(--brand-green);
		--orange: var(--brand-orange);
		--violet: var(--brand-stone);
		--shadow: 0 22px 70px color-mix(in srgb, var(--brand-brown) 18%, transparent);
		font-family:
			"Hiragino Sans", "Yu Gothic", "Meiryo", "Microsoft YaHei", "PingFang SC", "Xiaolai SC",
			"LXGW WenKai", "Kaiti SC", "KaiTi", system-ui, sans-serif;
		background: var(--cream);
		color: var(--ink);
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		min-width: 320px;
		background:
			radial-gradient(circle at 18% 8%, color-mix(in srgb, var(--brand-pink) 28%, transparent), transparent 28rem),
			radial-gradient(circle at 78% 16%, color-mix(in srgb, var(--brand-orange) 18%, transparent), transparent 26rem),
			linear-gradient(180deg, var(--brand-cream) 0%, #fff 58%, var(--brand-cream) 100%);
	}

	body::before {
		content: "";
		position: fixed;
		inset: 0;
		pointer-events: none;
		border: 1px solid var(--line);
		border-radius: 22px;
		z-index: 10;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	button,
	input {
		font: inherit;
	}

	img,
	svg {
		display: block;
