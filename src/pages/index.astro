		},
		downloadLabels: {
			windows: "Windows 版",
			linux: "Linux 版",
			macos: "macOS 版",
		},
		featuresTitle: '为什么选择 <em>grabbit</em>？',
		features: [
			{
				title: "多协议支持",
				body: "支持 HTTP/HTTPS、FTP、BitTorrent、Magnet 等多种下载协议。",
			},
			{
				title: "高速下载",
				body: "多线程加速，智能分配资源，充分利用你的网络带宽。",
