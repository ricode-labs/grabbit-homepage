---
const downloads = [
	{
		platform: "Windows",
		label: "下载 Windows 版",
		detail: "v1.2.0 · 64-bit · 78.6 MB",
		href: "#downloads",
		icon: "windows",
		primary: true,
	},
	{
		platform: "Linux",
		label: "下载 Linux 版",
		detail: "v1.2.0 · AppImage",
		href: "#downloads",
		icon: "linux",
		primary: false,
	},
	{
		platform: "macOS",
		label: "下载 macOS 版",
		detail: "v1.2.0 · Apple Silicon / Intel",
		href: "#downloads",
		icon: "apple",
		primary: false,
	},
];

const features = [
	{
		title: "多协议支持",
		body: "支持 HTTP/HTTPS、FTP、BitTorrent、Magnet 等多种下载协议。",
		image: "/pending.webp",
		icon: "cloud",
		iconAsset: "protocol",
		tone: "pink",
	},
	{
		title: "高速下载",
		body: "多线程加速，智能分配资源，充分利用你的网络带宽。",
		image: "/downloading.webp",
		icon: "bolt",
		tone: "stone",
	},
	{
		title: "断点续传",
		body: "意外中断？没关系！从上次中断处继续，不浪费任何进度。",
		image: "/paused.webp",
		icon: "upload",
		iconAsset: "cloud-download",
		tone: "orange",
	},
	{
		title: "任务管理",
		body: "清晰的任务列表，支持分类、排序、批量操作，一切井井有条。",
		image: "/pending.webp",
		icon: "list",
		tone: "green",
	},
	{
		title: "纯净安全",
		body: "无广告、无捆绑，开源透明，保护你的隐私与数据安全。",
		image: "/downloaded.webp",
		icon: "shield",
		tone: "brown",
		wide: true,
	},
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/webp" href="/favicon.webp?v=2" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="grabbit 是一款简洁可爱的桌面下载工具，支持多协议下载、任务管理、断点续传和实时速度统计。"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>grabbit - 轻松下载，一切尽在 grabbit</title>
	</head>
	<body>
		<main class="page-shell">
			<nav class="topbar" aria-label="主导航">
				<a class="brand" href="/" aria-label="grabbit 首页">
					<img src="/logo.svg" alt="" width="36" height="36" />
					<span>grabbit</span>
				</a>

				<div class="nav-links">
					<a href="#features">功能</a>
					<a href="#features">特性</a>
					<a href="#changelog">更新日志</a>
					<a href="#help">帮助</a>
					<a href="https://github.com" rel="noreferrer">GitHub</a>
					<a class="nav-download" href="#downloads" aria-label="立即下载">
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M12 3v9m0 0 3.5-3.5M12 12 8.5 8.5" />
							<path d="M5 14.5c-1.35.7-2 1.76-2 3.14C3 20 4.8 21 7.05 21h9.9C19.2 21 21 20 21 17.64c0-1.38-.65-2.44-2-3.14" />
						</svg>
						立即下载
					</a>
				</div>
			</nav>

			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-copy">
					<h1 id="hero-title">
						轻松下载，
						<span>一切尽在 <em>grabbit</em></span>
					</h1>
					<p class="hero-lede">
						简洁可爱的桌面下载工具，支持多协议下载、任务管理、断点续传，让下载变得更高效有趣。
					</p>

					<div class="download-actions" id="downloads" aria-label="下载入口">
						{downloads.map((download) => (
							<a
								class:list={["download-button", download.primary && "download-button-primary"]}
								href={download.href}
							>
								<span class={`platform-icon platform-icon-${download.icon}`} aria-hidden="true"></span>
								<span>
									<strong>{download.label}</strong>
									<small>{download.detail}</small>
								</span>
							</a>
						))}
					</div>

					<p class="support-note">
						<img src="/logo.svg" alt="" width="22" height="22" />
						支持 Windows 10+ / macOS 11+ / Linux
					</p>
				</div>

				<div class="app-preview" aria-label="grabbit 应用界面预览">
					<div class="screenshot-shell">
						<div class="screenshot-titlebar">
							<img src="/logo.svg" alt="" width="30" height="30" />
							<strong>grabbit</strong>
							<div class="screenshot-controls" aria-hidden="true">
								<span></span><span></span><span></span>
							</div>
						</div>
						<div class="screenshot-placeholder">
							<img src="/sidebar-bg.webp" alt="" width="230" height="180" />
							<div>
								<strong>软件截图占位</strong>
								<span>后续替换为真实 grabbit 截图</span>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section class="features" id="features" aria-labelledby="features-title">
				<h2 id="features-title">
					<span>✿</span>
					为什么选择 <em>grabbit</em>？
					<span>✿</span>
				</h2>

				<div class="feature-grid">
					{features.map((feature) => (
						<article class:list={["feature-card", feature.wide && "feature-card-wide"]}>
							<div class={`feature-icon feature-icon-${feature.tone}`} aria-hidden="true">
								{feature.iconAsset && <span class={`asset-icon asset-icon-${feature.iconAsset}`}></span>}
								{!feature.iconAsset && feature.icon === "cloud" && (
									<svg viewBox="0 0 24 24"><path d="M12 5v10m0 0-4-4m4 4 4-4" /><path d="M6 18h11a4 4 0 0 0 .8-7.92A6 6 0 0 0 6.2 8.7 4.7 4.7 0 0 0 6 18Z" /></svg>
								)}
								{!feature.iconAsset && feature.icon === "bolt" && (
									<svg viewBox="0 0 24 24"><path d="M13 2 4 14h7l-1 8 10-13h-7l0-7Z" /></svg>
								)}
								{!feature.iconAsset && feature.icon === "upload" && (
									<svg viewBox="0 0 24 24"><path d="M12 19V9m0 0-4 4m4-4 4 4" /><path d="M6 18H5a4 4 0 0 1 0-8 7 7 0 0 1 13.5-2A5 5 0 0 1 18 18h-1" /></svg>
								)}
								{!feature.iconAsset && feature.icon === "list" && (
									<svg viewBox="0 0 24 24"><path d="M8 6h11M8 12h11M8 18h11" /><path d="M4 6h.01M4 12h.01M4 18h.01" /></svg>
								)}
								{!feature.iconAsset && feature.icon === "shield" && (
									<svg viewBox="0 0 24 24"><path d="M12 3 5 6v6c0 4.5 2.8 7.6 7 9 4.2-1.4 7-4.5 7-9V6l-7-3Z" /><path d="m9 12 2 2 4-5" /></svg>
								)}
							</div>
							<div class="feature-copy">
								<h3>{feature.title}</h3>
								<p>{feature.body}</p>
							</div>
							<img src={feature.image} alt="" width="170" height="170" />
							<span class="flower flower-left" aria-hidden="true"></span>
							<span class="flower flower-right" aria-hidden="true"></span>
						</article>
					))}
				</div>
			</section>

			<section class="closing" id="help" aria-labelledby="closing-title">
				<img src="/paused.webp" alt="" width="210" height="210" />
				<div>
					<h2 id="closing-title">让每一次下载，<br />都变成一件愉快的小事。</h2>
					<p>
						<span>grabbit</span> 陪你一起，<br />
						把想要的都轻松 <span>grab</span> 住
					</p>
				</div>
				<img src="/downloaded.webp" alt="" width="210" height="210" />
			</section>

			<div id="changelog" class="sr-only">更新日志</div>
		</main>
	</body>
</html>

<style>
	:root {
		color-scheme: light;
		--brand-cream: #fffbf7;
		--brand-pink-soft: #ffe6ec;
		--brand-pink: #ffc7d4;
		--brand-orange: #f7a94a;
		--brand-green: #79c96b;
		--brand-stone: #bdb0a6;
		--brand-brown: #6b5448;
		--ink: var(--brand-brown);
		--ink-strong: color-mix(in srgb, var(--brand-brown) 86%, black);
		--muted: var(--brand-stone);
		--line: var(--brand-pink-soft);
		--surface: rgba(255, 251, 247, 0.78);
		--surface-solid: var(--brand-cream);
		--cream: var(--brand-cream);
		--pink: var(--brand-pink);
		--pink-deep: color-mix(in srgb, var(--brand-pink) 76%, var(--brand-brown));
		--pink-soft: var(--brand-pink-soft);
		--green: var(--brand-green);
		--orange: var(--brand-orange);
		--violet: var(--brand-stone);
		--shadow: 0 22px 70px color-mix(in srgb, var(--brand-brown) 18%, transparent);
		font-family:
			"Xiaolai SC", "LXGW WenKai", "Kaiti SC", "KaiTi", "Microsoft YaHei", "PingFang SC",
			system-ui, sans-serif;
		background: var(--cream);
		color: var(--ink);
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		min-width: 320px;
		background:
			radial-gradient(circle at 18% 8%, color-mix(in srgb, var(--brand-pink) 28%, transparent), transparent 28rem),
			radial-gradient(circle at 78% 16%, color-mix(in srgb, var(--brand-orange) 18%, transparent), transparent 26rem),
			linear-gradient(180deg, var(--brand-cream) 0%, #fff 58%, var(--brand-cream) 100%);
	}

	body::before {
		content: "";
		position: fixed;
		inset: 0;
		pointer-events: none;
		border: 1px solid var(--line);
		border-radius: 22px;
		z-index: 10;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	button,
	input {
		font: inherit;
	}

	img,
	svg {
		display: block;
	}

	.page-shell {
		width: min(1200px, calc(100% - 56px));
		margin: 0 auto;
		padding: 30px 0;
	}

	.topbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		min-height: 48px;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-size: 1.72rem;
		font-weight: 800;
		letter-spacing: 0;
		color: var(--ink);
	}

	.brand img {
		width: 36px;
		height: 36px;
		object-fit: contain;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 38px;
		font-family:
			"Microsoft YaHei", "PingFang SC", system-ui, sans-serif;
		font-size: 0.94rem;
		color: var(--ink);
	}

	.nav-links a {
		white-space: nowrap;
	}

	.nav-download {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 46px;
		border-radius: 16px;
		padding: 0 18px;
		background: linear-gradient(180deg, var(--brand-pink), var(--brand-pink-soft));
		color: var(--ink);
		font-weight: 800;
		box-shadow: 0 12px 26px color-mix(in srgb, var(--brand-pink) 44%, transparent);
	}

	.nav-download svg,
	.feature-icon svg {
		width: 20px;
		height: 20px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(320px, 0.82fr) minmax(520px, 1.18fr);
		gap: 62px;
		align-items: center;
		padding: 78px 22px 64px;
	}

	.hero-copy h1 {
		margin: 0 0 28px;
		font-size: clamp(2.85rem, 5vw, 4.35rem);
		line-height: 1.22;
		letter-spacing: 0;
		color: var(--ink);
		font-weight: 900;
	}

	.hero-copy h1 span {
		display: block;
	}

	em {
		color: var(--pink);
		font-style: normal;
	}

	.hero-copy h1::after {
		content: "✦";
		display: inline-block;
		margin-left: 14px;
		color: var(--brand-orange);
		font-size: 1.35rem;
		transform: translateY(-10px);
	}

	.hero-lede {
		max-width: 510px;
		margin: 0 0 34px;
		color: var(--ink);
		font-family:
			"Microsoft YaHei", "PingFang SC", system-ui, sans-serif;
		font-size: 1rem;
		line-height: 1.9;
	}

	.download-actions {
		display: grid;
		grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
		gap: 20px 14px;
		max-width: 410px;
	}

	.download-button {
		display: flex;
		align-items: center;
		gap: 12px;
		min-height: 78px;
		border: 1px solid var(--line);
		border-radius: 15px;
		padding: 14px 18px;
		background: color-mix(in srgb, var(--brand-cream) 82%, white);
		color: var(--ink);
		font-family:
			"Microsoft YaHei", "PingFang SC", system-ui, sans-serif;
		box-shadow: 0 14px 35px color-mix(in srgb, var(--brand-brown) 8%, transparent);
		transition:
			transform 160ms ease,
			box-shadow 160ms ease;
	}

	.download-button:hover {
		transform: translateY(-2px);
		box-shadow: 0 18px 36px color-mix(in srgb, var(--brand-brown) 14%, transparent);
	}

	.download-button-primary {
		background: linear-gradient(180deg, var(--brand-pink), var(--brand-pink-soft));
		border-color: transparent;
		color: var(--ink);
		box-shadow: 0 18px 36px color-mix(in srgb, var(--brand-pink) 48%, transparent);
	}

	.download-button:nth-child(3) {
		width: 224px;
		grid-column: 1 / -1;
	}

	.download-button strong,
	.download-button small {
		display: block;
	}

	.download-button strong {
		margin-bottom: 4px;
		font-size: 1rem;
		font-weight: 800;
	}

	.download-button small {
		font-size: 0.72rem;
		white-space: nowrap;
		opacity: 0.86;
	}

	.platform-icon {
		display: block;
		flex: 0 0 auto;
		width: 34px;
		height: 34px;
		background: currentColor;
		mask-position: center;
		mask-repeat: no-repeat;
		mask-size: contain;
		-webkit-mask-position: center;
		-webkit-mask-repeat: no-repeat;
		-webkit-mask-size: contain;
	}

	.platform-icon-windows {
		mask-image: url("/windows.svg");
		-webkit-mask-image: url("/windows.svg");
	}

	.platform-icon-linux {
		mask-image: url("/linux.svg");
		-webkit-mask-image: url("/linux.svg");
	}

	.platform-icon-apple {
		mask-image: url("/apple.svg");
		-webkit-mask-image: url("/apple.svg");
	}

	.support-note {
		display: flex;
		align-items: center;
		gap: 8px;
		margin: 34px 0 0;
		color: var(--muted);
		font-family:
			"Microsoft YaHei", "PingFang SC", system-ui, sans-serif;
		font-size: 0.86rem;
	}

	.app-preview {
		min-width: 0;
	}

	.screenshot-shell {
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: 22px;
		background: color-mix(in srgb, var(--brand-cream) 84%, white);
		box-shadow: var(--shadow);
		backdrop-filter: blur(20px);
	}

	.screenshot-titlebar {
		display: flex;
		align-items: center;
		gap: 8px;
		min-height: 52px;
		padding: 0 20px;
		border-bottom: 1px solid var(--line);
		color: var(--ink);
		font-size: 1.2rem;
	}

	.screenshot-titlebar img {
		width: 30px;
		height: 30px;
	}

	.screenshot-controls {
		display: flex;
		gap: 22px;
		align-items: center;
		margin-left: auto;
		color: var(--ink);
	}

	.screenshot-controls span {
		position: relative;
		width: 9px;
		height: 9px;
	}

	.screenshot-controls span:nth-child(1)::before {
		content: "";
		position: absolute;
		top: 4px;
		left: 1px;
		width: 7px;
		height: 1.5px;
		background: currentColor;
	}

	.screenshot-controls span:nth-child(2) {
		border: 1.5px solid currentColor;
		border-radius: 2px;
	}

	.screenshot-controls span:nth-child(3)::before,
	.screenshot-controls span:nth-child(3)::after {
		content: "";
		position: absolute;
		top: 4px;
		left: 0;
		width: 10px;
		height: 1.5px;
		background: currentColor;
	}

	.screenshot-controls span:nth-child(3)::before {
		transform: rotate(45deg);
	}

	.screenshot-controls span:nth-child(3)::after {
		transform: rotate(-45deg);
	}

	.screenshot-placeholder {
		position: relative;
		overflow: hidden;
		display: grid;
		place-items: center;
		aspect-ratio: 760 / 560;
		min-height: 420px;
		margin: 14px;
		border: 1px dashed var(--brand-pink);
		border-radius: 17px;
		background:
			linear-gradient(90deg, rgba(255, 255, 255, 0.74) 31px, transparent 1px) 0 0 / 32px 32px,
			linear-gradient(rgba(255, 255, 255, 0.74) 31px, transparent 1px) 0 0 / 32px 32px,
			linear-gradient(135deg, color-mix(in srgb, var(--brand-pink-soft) 78%, white), color-mix(in srgb, var(--brand-cream) 94%, white));
	}

	.screenshot-placeholder::before,
	.screenshot-placeholder::after {
		content: "";
		position: absolute;
		width: 42%;
		height: 1px;
		background: var(--brand-pink);
	}

	.screenshot-placeholder::before {
		transform: rotate(36deg);
	}

	.screenshot-placeholder::after {
		transform: rotate(-36deg);
	}

	.screenshot-placeholder img {
		position: relative;
		z-index: 1;
		width: min(36%, 230px);
		height: auto;
		opacity: 0.88;
	}

	.screenshot-placeholder div {
		position: relative;
		z-index: 1;
		display: grid;
		gap: 6px;
		justify-items: center;
		border: 1px solid var(--line);
		border-radius: 16px;
		padding: 16px 22px;
		background: color-mix(in srgb, var(--brand-cream) 74%, white);
		box-shadow: 0 16px 42px color-mix(in srgb, var(--brand-brown) 10%, transparent);
	}

	.screenshot-placeholder strong,
	.screenshot-placeholder span {
		font-family:
			"Microsoft YaHei", "PingFang SC", system-ui, sans-serif;
		line-height: 1.4;
	}

	.screenshot-placeholder strong {
		color: var(--ink);
		font-size: 1rem;
	}

	.screenshot-placeholder span {
		color: var(--muted);
		font-size: 0.78rem;
	}

	.features {
		padding: 6px 0 30px;
	}

	.features h2 {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 18px;
		margin: 0 0 28px;
		color: var(--ink);
		font-size: clamp(1.82rem, 3.5vw, 2.42rem);
		line-height: 1.2;
		letter-spacing: 0;
		text-align: center;
	}

	.features h2 span {
		color: var(--brand-pink);
		font-size: 1.35rem;
	}

	.feature-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 20px 26px;
	}

	.feature-card {
		position: relative;
		overflow: hidden;
		display: grid;
		grid-template-columns: 76px minmax(0, 1fr) 176px;
		align-items: center;
		min-height: 218px;
		border: 1px solid var(--line);
		border-radius: 22px;
		padding: 26px;
		background: color-mix(in srgb, var(--brand-cream) 68%, white);
		box-shadow: 0 18px 48px color-mix(in srgb, var(--brand-brown) 7%, transparent);
	}

	.feature-card-wide {
		grid-column: 1 / -1;
		grid-template-columns: minmax(76px, 0.22fr) minmax(0, 1fr) 220px;
		min-height: 136px;
	}

	.feature-icon {
		display: grid;
		place-items: center;
		width: 66px;
		height: 66px;
		border-radius: 50%;
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--brand-brown) 8%, transparent);
		color: var(--brand-cream);
	}

	.feature-icon-pink {
		background: color-mix(in srgb, var(--brand-pink) 76%, var(--brand-brown));
	}

	.feature-icon-stone {
		background: var(--brand-stone);
	}

	.feature-icon-orange {
		background: var(--brand-orange);
	}

	.feature-icon-green {
		background: var(--brand-green);
	}

	.feature-icon-brown {
		background: var(--brand-brown);
		box-shadow: none;
	}

	.feature-icon svg {
		width: 32px;
		height: 32px;
	}

	.asset-icon {
