		changelog: "Changelog",
	},
	zh: {
		htmlLang: "zh-CN",
		title: "grabbit - 轻松下载，一切尽在 grabbit",
		description:
			"grabbit 是一款简洁可爱的桌面下载工具，支持多协议下载、任务管理、断点续传和实时速度统计。",
		nav: {
